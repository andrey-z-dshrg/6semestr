                  "const json = pm.response.json();",
                  "const createdSignature = pm.collectionVariables.get('createdSignature');",
                  "pm.collectionVariables.set('updatedSignature', json.digitalSignature);",
                  "pm.collectionVariables.set('updatedUpdatedAt', json.updatedAt);",
                  "pm.test('Update recalculates digital signature', function () {",
                  "    pm.expect(json.digitalSignature).to.not.eql(createdSignature);",
                  "});"
