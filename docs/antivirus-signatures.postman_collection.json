                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const signatureId = Number(pm.collectionVariables.get('signatureId'));",
                  "pm.test('Full export contains created signature and no DELETED', function () {",
                  "    pm.expect(json.some(item => item.id === signatureId)).to.eql(true);",
                  "    pm.expect(json.every(item => item.status !== 'DELETED')).to.eql(true);",
                  "});"
                ]
