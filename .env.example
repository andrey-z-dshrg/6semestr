# Copy this file to .env and replace the placeholder values.

JWT_SECRET=change-me-jwt-secret-with-at-least-32-characters

SERVER_SSL_KEY_STORE=classpath:keystore/quiz-server-keystore.p12
SERVER_SSL_KEY_STORE_PASSWORD=change-me
SERVER_SSL_KEY_ALIAS=makarovServer
SERVER_SSL_KEY_PASSWORD=change-me

SIGNATURE_KEY_STORE_PATH=classpath:keystore/quiz-server-keystore.p12
SIGNATURE_KEY_STORE_TYPE=PKCS12
SIGNATURE_KEYSTORE_PASSWORD=change-me
SIGNATURE_KEY_ALIAS=makarovServer
SIGNATURE_KEY_PASSWORD=change-me
SIGNATURE_PUBLIC_KEY_BASE64=
SIGNATURE_ALGORITHM=SHA256withRSA

MINIO_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=app-signatures
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=signature-files
MINIO_PRESIGNED_URL_TTL_MINUTES=30
SIGNATURE_FIRST_BYTES_LENGTH=16
